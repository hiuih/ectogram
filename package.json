{
  "name": "instagram-desktop",
  "version": "1.0.0",
  "description": "Unofficial native macOS wrapper for Instagram Web",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.local.instagramdesktop",
    "productName": "Ectogram",
    "files": [
      "main.js",
      "splash.html",
      "build-assets/icon-512.png",
      "build-assets/icon.icns"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build-assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Instagram needs camera access to take photos, film Stories, and make video calls.",
        "NSMicrophoneUsageDescription": "Instagram needs microphone access for voice and video calls.",
        "NSMicrophoneUsageDescriptionMac": "Instagram needs microphone access for voice and video calls.",
        "LSMinimumSystemVersion": "11.0"
      }
    }
  }
}
